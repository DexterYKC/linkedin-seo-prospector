{
  "manifest_version": 3,
  "name": "Seoprospector",
  "version": "1.1.0",
  "description": "LinkedIn lead generation for SEO agencies. Capture prospects, score leads, and send AI-powered outreach — all from your browser.",

  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "sidePanel"
  ],

  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.bing.com/*",
    "https://n8n.example.com/*",
    "https://api.example.com/*",
    "https://app.example.com/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://app.example.com/*"],
      "js": ["content_site.js"],
      "run_at": "document_start"
    }
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Seoprospector",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "panel.html"
  }
}
